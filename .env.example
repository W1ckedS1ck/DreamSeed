# ═══════════════════════════════════════════════════════════════════════
#  Secrets storage map
# ═══════════════════════════════════════════════════════════════════════
#
#  📁 secrets/.env (gitignored)
#     → deploy.sh, ansible lookup('env',...)
#     → ВСЕ переменные ниже идут сюда, КРОМЕ:
#
#  🔐 terraform/grafana/terraform.tfvars (ansible-vault, в git)
#     → grafana_cloud_url
#     → grafana_cloud_token
#     → sm_access_token
#     → sm_url
#
#  🤖 GitHub Actions (Settings → Secrets → Actions)
#     → TF_API_TOKEN
#     → HCLOUD_TOKEN
#     → CLOUDFLARE_API_TOKEN
#     → TG_TOKEN · TG_CHAT_ID · TG_THREAD_ID
#     → VAULT_PASSWORD
#     → USER_SSH_PUBLIC_KEY
#     → SSH_PRIVATE_KEY (deploy_key)
#     → RCLONE_CONF_B64
#     → PROD_ACCESS_KEY · PROD_SECRET_KEY · PROD_REGION · PROD_EIP
#     → DEV_AWS_ACCESS_KEY · DEV_AWS_SECRET_KEY · DEV_AWS_REGION · DEV_AWS_EIP
#     → PROD_GRAFANA_CLOUD_URL · PROD_GRAFANA_CLOUD_USERNAME · PROD_GRAFANA_CLOUD_TOKEN
#     → DEV_GRAFANA_CLOUD_URL · DEV_GRAFANA_CLOUD_USERNAME · DEV_GRAFANA_CLOUD_TOKEN
#     → PROD_GRAFANA_CLOUD_SA_TOKEN · DEV_GRAFANA_CLOUD_SA_TOKEN
#     → PROD_SM_ACCESS_TOKEN · DEV_SM_ACCESS_TOKEN
#     → BETTERUPTIME_API_TOKEN · BETTERUPTIME_*_KEY
#     → PROD_GRAFANA_CLOUD_* · DEV_GRAFANA_CLOUD_*
# ═══════════════════════════════════════════════════════════════════════

# ─── Telegram (BotFather) ─────────────────────────────────────────────────────
TG_TOKEN=""
TG_CHAT_ID=""
TG_THREAD_ID=""
OWNER=""
# BOT_USERNAME=""  # Bot username for /status command (default: DreamSeedOnline_bot)

# ─── Database & Grafana (shared) ──────────────────────────────────────────────
DB_NAME="modx_db"
DB_PASS=""
GRAFANA_PASS=""
# DB_PREFIX=""     # MySQL table prefix for Telegram bot (default: db_modx_db_)

# ─── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# ─── Terraform Cloud ──────────────────────────────────────────────────────────
TF_API_TOKEN=""

# ─── SSH keys ─────────────────────────────────────────────────────────────────
SSH_PUBLIC_KEY_PATH="$HOME/.ssh/id_ed25519.pub"
SSH_PRIVATE_KEY_PATH="$HOME/.ssh/id_ed25519"
# ADDITIONAL_SSH_KEYS="ssh-ed25519 AAAA..."

# ─── Better Uptime (external watchdog) ────────────────────────────────────────
BETTERUPTIME_API_TOKEN=""
# BETTERUPTIME_BACKUP_KEY=""
# BETTERUPTIME_GDRIVE_KEY=""
# BETTERUPTIME_REPORT_DAILY_KEY=""
# BETTERUPTIME_REPORT_WEEKLY_KEY=""
# BETTERUPTIME_VERIFY_KEY=""

# ─── Legacy healthchecks.io (portfolio reference only) ────────────────────────
# HEALTHCHECKS_API_KEY=""
# HEALTHCHECK_BACKUP_UUID=""
# HEALTHCHECK_GDRIVE_UUID=""
# HEALTHCHECK_REPORT_DAILY_UUID=""
# HEALTHCHECK_REPORT_WEEKLY_UUID=""

# ─── Grafana Cloud (per-target, push tokens for vmagent) ─────────────────────
PROD_GRAFANA_CLOUD_URL=""
PROD_GRAFANA_CLOUD_USERNAME=""
PROD_GRAFANA_CLOUD_TOKEN=""

DEV_GRAFANA_CLOUD_URL=""
DEV_GRAFANA_CLOUD_USERNAME=""
DEV_GRAFANA_CLOUD_TOKEN=""

# ─── Grafana Cloud (Service Account tokens for Terraform) ────────────────────
# SA tokens with org viewer scope for provisioning dashboards
PROD_GRAFANA_CLOUD_SA_TOKEN=""
DEV_GRAFANA_CLOUD_SA_TOKEN=""

# ─── Synthetic Monitoring (optional) ───────────────────────────────────────
# Enable SM once in Grafana Cloud UI (Stack → SM → Enable).
# Then SA token with SM scope is all that's needed — falls back automatically.
# PROD_SM_ACCESS_TOKEN=""
# DEV_SM_ACCESS_TOKEN=""

# ─── prod (AWS) ──────────────────────────────────────────────────────────────
PROD_ACCESS_KEY=""
PROD_SECRET_KEY=""
PROD_REGION="us-west-1"
PROD_EIP=""  # Elastic IP allocation ID (eipalloc-xxx), not the IP address itself

# ─── dev-aws ─────────────────────────────────────────────────────────────────
DEV_AWS_ACCESS_KEY=""
DEV_AWS_SECRET_KEY=""
DEV_AWS_REGION="us-west-1"
DEV_AWS_EIP=""  # Elastic IP allocation ID (eipalloc-xxx), not the IP address itself

# ─── dev-hetz ────────────────────────────────────────────────────────────────
HCLOUD_TOKEN=""
HETZNER_SERVER_TYPE="cx23"
HETZNER_LOCATION="nbg1"
HETZNER_SSH_KEY_NAME=""
HETZNER_PRIMARY_IP_NAME=""

# ─── Monitoring exporter versions (optional overrides) ───────────────────────
# Leave commented to use defaults; set to override per deployment
# GRAFANA_VERSION="12.4.3"
# MONITORING_NODE_VERSION="1.11.1"
# MONITORING_NGINX_VERSION="1.5.1"
# MONITORING_APACHE_VERSION="1.0.12"
# MONITORING_MYSQL_VERSION="0.19.0"
# MONITORING_VM_VERSION="1.144.0"
# MONITORING_VMAGENT_VERSION="1.144.0"
