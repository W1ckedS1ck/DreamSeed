# ═══════════════════════════════════════════════════════════════════════
#  Secrets storage map
# ═══════════════════════════════════════════════════════════════════════
#
#  📁 secrets/.env (gitignored)
#     → deploy.sh, ansible lookup('env',...)
#     → ALL variables below go here, EXCEPT:
#
#  🔐 terraform/grafana/terraform.tfvars (plain JSON, gitignored)
#     → grafana_cloud_url
#     → grafana_cloud_token
#     → sm_access_token
#     → sm_url
#
#  🤖 GitHub Actions (Settings → Secrets → Actions)
#     → TF_API_TOKEN
#     → HCLOUD_TOKEN · PROD_HETZ_HCLOUD_TOKEN
#     → CLOUDFLARE_API_TOKEN
#     → TG_TOKEN · TG_CHAT_ID (var) · TG_THREAD_ID (var)
#     → VAULT_PASSWORD
#     → USER_SSH_PUBLIC_KEY · VITALI_SSH_PUBLIC_KEY
#     → SSH_PRIVATE_KEY (deploy_key)
#     → RCLONE_CONF_BASE64
#     → PROD_ACCESS_KEY · PROD_SECRET_KEY · PROD_REGION · PROD_EIP
#     → DEV_AWS_ACCESS_KEY · DEV_AWS_SECRET_KEY · DEV_AWS_REGION · DEV_AWS_EIP · DEV_AWS_SSH_PUBLIC_KEY
#     → PROD_GRAFANA_CLOUD_URL · PROD_GRAFANA_CLOUD_USERNAME · PROD_GRAFANA_CLOUD_TOKEN
#     → DEV_GRAFANA_CLOUD_URL · DEV_GRAFANA_CLOUD_USERNAME · DEV_GRAFANA_CLOUD_TOKEN
#     → PROD_SM_ACCESS_TOKEN · DEV_SM_ACCESS_TOKEN
#     → BETTERUPTIME_API_TOKEN · BETTERUPTIME_*_KEY
# ═══════════════════════════════════════════════════════════════════════

# ─── Telegram (BotFather) ─────────────────────────────────────────────────────
TG_TOKEN=""
TG_CHAT_ID=""
TG_THREAD_ID=""
OWNER=""

# ─── Database & Grafana (shared) ──────────────────────────────────────────────
DB_NAME="modx_db"
DB_PASS=""
GRAFANA_PASS=""

# ─── Cloudflare (zone ID auto-detected from domain via API) ───────────────────
CLOUDFLARE_API_TOKEN=""

# ─── Terraform Cloud ──────────────────────────────────────────────────────────
TF_API_TOKEN=""

# ─── SSH keys ─────────────────────────────────────────────────────────────────
SSH_PUBLIC_KEY_PATH="$HOME/.ssh/Vitali.pub"
SSH_PRIVATE_KEY_PATH="$HOME/.ssh/Vitali.pem"

# Additional public keys injected into all servers via cloud-init.
# The deploy key (SSH_PUBLIC_KEY_PATH) is always included automatically.
# Add extra keys here (one per line) for team members.
ADDITIONAL_SSH_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHnlra4vLtdXHPRNmOqtzrHlYh5oqAaGM24jTxM/yUft 2024@DESKTOP-6ADBQSM"

# ─── Better Uptime (external watchdog) ────────────────────────────────────────
BETTERUPTIME_API_TOKEN=""
BETTERUPTIME_BACKUP_KEY=""
BETTERUPTIME_GDRIVE_KEY=""
BETTERUPTIME_REPORT_DAILY_KEY=""
BETTERUPTIME_REPORT_WEEKLY_KEY=""
BETTERUPTIME_VERIFY_KEY=""

# ─── Grafana Cloud (per-target, push tokens for vmagent) ─────────────────────
# URL:      Prometheus regional endpoint from Grafana Cloud Portal → Details.
#           Format: https://prometheus-prod-<NN>-<region>.grafana.net
#           ⚠ NOT the vanity URL <stack>.grafana.net (that's for Grafana UI).
#           ⚠ Do NOT append /api/prom/push — the template adds it.
# USERNAME: numeric Prometheus instance ID (7 digits), shown next to the URL.
# TOKEN:    Cloud Access Policy token with scope=metrics:write (prefix glc_*).
#           ⚠ NOT a Service Account token (glsa_*) — that goes to _SA_TOKEN below.
PROD_GRAFANA_CLOUD_URL=""
PROD_GRAFANA_CLOUD_USERNAME=""
PROD_GRAFANA_CLOUD_TOKEN=""

DEV_GRAFANA_CLOUD_URL=""
DEV_GRAFANA_CLOUD_USERNAME=""
DEV_GRAFANA_CLOUD_TOKEN=""

# ─── Grafana Cloud SA (Terraform) — Service Account tokens ──────────────
# Service Account token (glsa_*) with role=Admin, used by Terraform Grafana provider.
# Falls back to GRAFANA_CLOUD_TOKEN for prod if not set (for backward compatibility).
PROD_GRAFANA_CLOUD_SA_TOKEN=""
DEV_GRAFANA_CLOUD_SA_TOKEN=""

# ─── Synthetic Monitoring (optional) ───────────────────────────────────────
# Enable SM once in Grafana Cloud UI (Stack → SM → Enable).
# Then SA token with SM scope is all that's needed — falls back automatically.
# PROD_SM_ACCESS_TOKEN=""
# DEV_SM_ACCESS_TOKEN=""

# ─── prod (AWS) ──────────────────────────────────────────────────────────────
PROD_ACCESS_KEY=""
PROD_SECRET_KEY=""
PROD_REGION="us-west-1"
PROD_EIP=""  # Set to any non-empty value to disable auto-public-IP (use when managing EIP outside TF)

# ─── dev-aws ─────────────────────────────────────────────────────────────────
DEV_AWS_ACCESS_KEY=""
DEV_AWS_SECRET_KEY=""
DEV_AWS_REGION="us-west-1"
DEV_AWS_EIP=""  # Set to any non-empty value to disable auto-public-IP (use when managing EIP outside TF)

# ─── dev-hetz ────────────────────────────────────────────────────────────────
DEV_HETZ_HCLOUD_TOKEN=""
DEV_HETZ_SERVER_TYPE="cx23"
DEV_HETZ_LOCATION="nbg1"
DEV_HETZ_SSH_KEY_NAME=""
DEV_HETZ_PRIMARY_IP_NAME=""

# ─── prod-hetz (Hetzner) ────────────────────────────────────────────────────
PROD_HETZ_HCLOUD_TOKEN=""
PROD_HETZ_SERVER_TYPE="cx43"
PROD_HETZ_LOCATION="nbg1"
PROD_HETZ_SSH_KEY_NAME=""       # Empty = TF creates CI key automatically
PROD_HETZ_PRIMARY_IP_NAME=""    # Empty + ENABLE_PRIMARY_IP=true = TF creates Primary IP
PROD_HETZ_ENABLE_PRIMARY_IP="true"

# ─── Monitoring exporter versions (optional overrides) ───────────────────────
# Leave commented to use defaults; set to override per deployment
# GRAFANA_VERSION="12.4.5"
# MONITORING_NODE_VERSION="1.11.1"
# MONITORING_NGINX_VERSION="1.5.1"
# MONITORING_APACHE_VERSION="1.0.12"
# MONITORING_MYSQL_VERSION="0.19.0"
# MONITORING_VM_VERSION="1.145.0"
# MONITORING_VMAGENT_VERSION="1.145.0"

# ═══════════════════════════════════════════════════════════════════════════════
#  Legacy — keep for reference
# ═══════════════════════════════════════════════════════════════════════════════

