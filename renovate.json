{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies", "renovate"],
  "enabledManagers": ["github-actions", "terraform", "pip_requirements", "ansible-galaxy", "pre-commit"],
  "terraform": {
    "managerFilePatterns": [
      "terraform/.*\\.tf$"
    ],
    "versioning": "semver"
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/ansible/requirements\\.txt$",
      "/ansible/requirements-deploy\\.txt$"
    ]
  },
  "ansible-galaxy": {
    "managerFilePatterns": [
      "/ansible/requirements\\.yml$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track node_exporter version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["monitoring_node_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "prometheus/node_exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track nginx-prometheus-exporter version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["monitoring_nginx_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "nginxinc/nginx-prometheus-exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track mysqld_exporter version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["monitoring_mysql_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "prometheus/mysqld_exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track VictoriaMetrics version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["monitoring_vm_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "VictoriaMetrics/VictoriaMetrics",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Grafana version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["grafana_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "grafana/grafana",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track apache_exporter version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["monitoring_apache_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "Lusitaniae/apache_exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track vmagent version",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["monitoring_vmagent_version: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "VictoriaMetrics/VictoriaMetrics",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track gitleaks version",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": ["GITLEAKS_VERSION: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track tflint-ruleset-aws version",
      "managerFilePatterns": [
        "/^terraform/aws/\\.tflint\\.hcl$/"
      ],
      "matchStrings": ["version = \"(?<currentValue>.*?)\""],
      "depNameTemplate": "terraform-linters/tflint-ruleset-aws",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHAs for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group VictoriaMetrics server and vmagent — always released together",
      "matchPackageNames": ["VictoriaMetrics/VictoriaMetrics"],
      "matchManagers": ["custom.regex"],
      "groupName": "VictoriaMetrics",
      "labels": ["dependencies", "monitoring"]
    },
    {
      "description": "Group all non-major Terraform provider updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Terraform providers",
      "labels": ["terraform", "update"]
    },
    {
      "description": "Major Terraform updates — separate PRs with review label",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["major"],
      "labels": ["terraform", "major-update", "needs-review"]
    }
  ]
}
