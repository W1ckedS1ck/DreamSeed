{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies", "renovate"],
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "major": {
    "dependencyDashboardApproval": true
  },
  "enabledManagers": ["github-actions", "terraform", "pip_requirements", "ansible-galaxy", "pre-commit", "regex"],
  "terraform": {
    "fileMatch": [
      "terraform/.*\\.tf$"
    ],
    "versioning": "semver"
  },
  "pip_requirements": {
    "fileMatch": [
      "ansible/requirements\\.txt$",
      "ansible/requirements-deploy\\.txt$"
    ]
  },
  "ansible-galaxy": {
    "fileMatch": [
      "ansible/requirements\\.yml$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track node_exporter version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["monitoring_node_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "prometheus/node_exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track nginx-prometheus-exporter version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["monitoring_nginx_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "nginxinc/nginx-prometheus-exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track mysqld_exporter version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["monitoring_mysql_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "prometheus/mysqld_exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track VictoriaMetrics version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["monitoring_vm_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "VictoriaMetrics/VictoriaMetrics",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Grafana version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["grafana_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "grafana/grafana",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track apache_exporter version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["monitoring_apache_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "Lusitaniae/apache_exporter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track vmagent version",
      "fileMatch": [
        "^ansible/group_vars/all\\.yml$"
      ],
      "matchStrings": ["monitoring_vmagent_version: \"{{.*?default\\('(?<currentValue>[^']+)'.*\\) }}\""],
      "depNameTemplate": "VictoriaMetrics/VictoriaMetrics",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track gitleaks version",
      "fileMatch": [
        "^\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": ["GITLEAKS_VERSION: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track tflint plugin versions (.tflint.hcl)",
      "fileMatch": [
        "^\\.tflint\\.hcl$"
      ],
      "matchStrings": ["version = \"(?<currentValue>[\\d.]+)\"\\s+# renovate: depName=(?<depName>\\S+)"],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Terraform CLI version in setup-terraform action",
      "fileMatch": [
        "^\\.github/actions/setup-terraform/action\\.yml$"
      ],
      "matchStrings": ["default: \"(?<currentValue>[\\d.]+)\"\\s+# renovate: depName=hashicorp/terraform"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track tflint version in CI",
      "fileMatch": [
        "^\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": ["TFLINT_VERSION: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track j2lint version in CI",
      "fileMatch": [
        "^\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": ["pip install j2lint==(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "aristanetworks/j2lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHAs for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group VictoriaMetrics server and vmagent — always released together",
      "matchPackageNames": ["VictoriaMetrics/VictoriaMetrics"],
      "matchManagers": ["custom.regex"],
      "groupName": "VictoriaMetrics",
      "labels": ["dependencies", "monitoring"]
    },
    {
      "description": "Group all non-major Terraform provider updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Terraform providers",
      "labels": ["terraform", "update"]
    },
    {
      "description": "Major Terraform updates — separate PRs with review label",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["major"],
      "labels": ["terraform", "major-update", "needs-review"]
    }
  ]
}
