{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies", "renovate"],
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "major": {
    "dependencyDashboardApproval": true
  },
  "enabledManagers": ["github-actions", "terraform", "pip_requirements", "ansible-galaxy", "pre-commit", "custom.regex"],
  "pip_requirements": {
    "fileMatch": [
      "/ansible/requirements\\.txt$/",
      "/ansible/requirements-deploy\\.txt$/"
    ]
  },
  "ansible-galaxy": {
    "fileMatch": [
      "/ansible/requirements\\.yml$/"
    ]
  },
  "terraform": {},

  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Ansible monitoring versions via inline comments",
      "fileMatch": [
        "/ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": ["default\\('(?<currentValue>[\\w.\\-]+)'[^#]*# renovate: depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)"]
    },
    {
      "customType": "regex",
      "description": "Track gitleaks version",
      "fileMatch": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": ["GITLEAKS_VERSION: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track tflint plugin versions (.tflint.hcl)",
      "fileMatch": [
        "/^\\.tflint\\.hcl$/"
      ],
      "matchStrings": ["version = \"(?<currentValue>v?[\\w.\\-]+)\"\\s+# renovate: depName=(?<depName>\\S+)"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track Terraform CLI version in setup-terraform action",
      "fileMatch": [
        "/^\\.github/actions/setup-terraform/action\\.yml$/"
      ],
      "matchStrings": ["default: \"(?<currentValue>[\\w.\\-]+)\"\\s+# renovate: depName=hashicorp/terraform"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track tflint version in CI",
      "fileMatch": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": ["TFLINT_VERSION: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track j2lint version in CI",
      "fileMatch": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": ["pip install j2lint==(?<currentValue>[\\w.\\-]+)"],
      "depNameTemplate": "aristanetworks/j2lint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHAs for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Auto-approve actions/checkout updates",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/checkout"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Group VictoriaMetrics server and vmagent — always released together",
      "matchPackageNames": ["VictoriaMetrics/VictoriaMetrics"],
      "matchManagers": ["custom.regex"],
      "groupName": "VictoriaMetrics",
      "labels": ["dependencies", "monitoring"]
    },
    {
      "description": "Group all non-major Terraform provider updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Terraform providers",
      "labels": ["terraform", "update"]
    },
    {
      "description": "Major Terraform updates — separate PRs with review label",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["major"],
      "labels": ["terraform", "major-update", "needs-review"]
    },
    {
      "description": "Require approval for major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group non-major python dependencies",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python pip packages"
    }
  ]
}
