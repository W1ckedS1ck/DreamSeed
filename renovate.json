{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies", "renovate"],
  "enabledManagers": ["github-actions", "terraform", "pip_requirements", "ansible-galaxy"],
  "terraform": {
    "fileMatch": [
      "/terraform/.*\\.tf$/"
    ],
    "versioning": "semver"
  },
  "pip_requirements": {
    "fileMatch": [
      "ansible/requirements\\.txt$",
      "ansible/requirements-deploy\\.txt$"
    ]
  },
  "ansible-galaxy": {
    "fileMatch": [
      "ansible/requirements\\.yml$"
    ]
  },
  "packageRules": [
    {
      "description": "Group all non-major Terraform provider updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Terraform providers",
      "labels": ["terraform", "update"]
    },
    {
      "description": "Major Terraform updates — separate PRs with review label",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["major"],
      "labels": ["terraform", "major-update", "needs-review"]
    }
  ]
}
