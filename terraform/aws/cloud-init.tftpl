#!/bin/bash

# --- SSH keys BEFORE set -e so hostnamectl can't break auth ---
# (parity with terraform/hetzner/cloud-init.tftpl — keep both in sync)
mkdir -p /home/ubuntu/.ssh
%{if length(additional_ssh_keys) > 0~}
%{for key in additional_ssh_keys~}
echo '${base64encode(key)}' | base64 -d 2>/dev/null >> /home/ubuntu/.ssh/authorized_keys && echo '' >> /home/ubuntu/.ssh/authorized_keys
%{endfor~}
%{endif~}
chmod 600 /home/ubuntu/.ssh/authorized_keys
chown -R ubuntu:ubuntu /home/ubuntu/.ssh

set -e
hostnamectl set-hostname dreamseed-${environment}

sed -i -E 's/^#?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
systemctl reload ssh || true
