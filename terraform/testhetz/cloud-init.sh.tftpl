#!/bin/bash
set -e

hostnamectl set-hostname testhetz-${server_type}

apt-get update -qq
apt-get install -y -qq \
  build-essential \
  htop \
  neofetch \
  wget \
  curl \
  unzip \
  cpuid > /dev/null

cd /home/ubuntu

# Find latest GeekBench 6.x
GB_VER=""
for v in 6.7.1 6.7.0 6.6.1 6.6.0 6.5.0 6.4.0 6.3.0 6.2.2 6.2.1 6.2.0 6.1.0 6.0.3; do
  if curl -sfIL --connect-timeout 5 "https://cdn.geekbench.com/Geekbench-${v}-Linux.tar.gz" > /dev/null 2>&1; then
    GB_VER="$v"
    break
  fi
done
if [ -n "$GB_VER" ]; then
  wget -q "https://cdn.geekbench.com/Geekbench-${GB_VER}-Linux.tar.gz"
  tar xzf "Geekbench-${GB_VER}-Linux.tar.gz"
  rm -f "Geekbench-${GB_VER}-Linux.tar.gz"
  chown -R ubuntu:ubuntu "/home/ubuntu/Geekbench-${GB_VER}-Linux"
  GB_DIR="Geekbench-${GB_VER}-Linux"
else
  echo "[WARN] Could not download GeekBench — skipping"
  GB_DIR=""
fi

echo "CPU info:" > /home/ubuntu/benchmark-info.txt
cat /proc/cpuinfo | grep -E "model name|siblings|cpu cores" | sort -u >> /home/ubuntu/benchmark-info.txt
echo "" >> /home/ubuntu/benchmark-info.txt
echo "Memory:" >> /home/ubuntu/benchmark-info.txt
free -h >> /home/ubuntu/benchmark-info.txt
echo "" >> /home/ubuntu/benchmark-info.txt
echo "lscpu:" >> /home/ubuntu/benchmark-info.txt
lscpu >> /home/ubuntu/benchmark-info.txt

echo "=== SETUP COMPLETE ==="
echo "Server: testhetz-${server_type}"
if [ -n "$GB_DIR" ]; then
  echo "GeekBench: /home/ubuntu/${GB_DIR}/geekbench6 (v${GB_VER})"
  echo "Run: cd ${GB_DIR} && ./geekbench6"
else
  echo "GeekBench: NOT INSTALLED"
fi
