# Managed by Ansible

{% macro alert_body(uid, title, expr, range_from, thresh_val, thresh_type, for_dur, no_data, exec_err, severity) %}
      - uid: dreamseed-{{ uid }}
        title: {{ title }}
        condition: B
        labels:
          env: {{ deploy_env }}
          severity: {{ severity }}
        data:
          - refId: A
            datasourceUid: VictoriaMetrics
            queryType: ''
            relativeTimeRange:
              from: {{ range_from }}
              to: 0
            model:
              expr: '{{ expr }}'
              instant: true
              refId: A
          - refId: B
            datasourceUid: '__expr__'
            queryType: ''
            relativeTimeRange:
              from: {{ range_from }}
              to: 0
            model:
              type: threshold
              refId: B
              expression: A
              conditions:
                - evaluator:
                    params: [{{ thresh_val }}]
                    type: {{ thresh_type }}
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                  type: query
        noDataState: {{ no_data }}
        execErrState: {{ exec_err }}
        for: {{ for_dur }}
{% endmacro %}

# Updated 2026-06-05 — severity grouping + tuned for/noDataState
apiVersion: 1

contactPoints:
  - orgId: 1
    name: Telegram
    receivers:
      - uid: dreamseed-telegram
        type: telegram
        settings:
          chatid: "{{ grafana_telegram_chat_id }}"
{% if grafana_telegram_thread_id | length > 0 %}
          message_thread_id: "{{ grafana_telegram_thread_id }}"
{% endif %}
          bottoken: "{{ grafana_telegram_token }}"
          message: "{% raw %}{{ if .Alerts.Firing }}🔴 [{{ .GroupLabels.env }}] {{ (index .Alerts.Firing 0).Labels.alertname }}{{ if (index .Alerts.Firing 0).Annotations.summary }}\n{{ (index .Alerts.Firing 0).Labels.severity }}: {{ (index .Alerts.Firing 0).Annotations.summary }}{{ end }}{{ end }}{{ if .Alerts.Resolved }}✅ [{{ .GroupLabels.env }}] {{ (index .Alerts.Resolved 0).Labels.alertname }} — resolved{{ end }}{% endraw %}"
        disableResolveMessage: false

policies:
  - orgId: 1
    receiver: Telegram
    group_by:
      - alertname
      - env
    group_wait: 30s
    group_interval: 1m
    repeat_interval: 4h
    routes:
      - matchers:
          - severity = critical
        receiver: Telegram
        repeat_interval: 1h

groups:
  - orgId: 1
    name: DreamSeed
    folder: Alerts
    interval: 2m
    rules:

{{ alert_body('high-cpu', 'High CPU', '100 - (avg by(instance)(rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)', 300, 85, 'gt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: CPU usage > 85% for 5 min

{{ alert_body('high-ram', 'High RAM', '100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)', 300, 90, 'gt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: RAM usage > 90%

{{ alert_body('low-disk', 'Low Disk Space', '100 * node_filesystem_avail_bytes{fstype!~"tmpfs|devtmpfs",mountpoint="/"} / node_filesystem_size_bytes{fstype!~"tmpfs|devtmpfs",mountpoint="/"}', 300, 10, 'lt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}Disk < 10% free (mountpoint: {{ $labels.mountpoint }}){% endraw %}

{{ alert_body('swap-thrashing', 'Swap Thrashing Detected', 'rate(node_vmstat_pswpin[5m])', 300, 100, 'gt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}Swap page-in rate > 100 pages/s — memory pressure detected on {{ $labels.instance }}{% endraw %}

{{ alert_body('mysql-down', 'MySQL Down', 'mysql_up', 60, 1, 'lt', '2m', 'Alerting', 'Error', 'critical') }}
        annotations:
          summary: MariaDB service is not running

{{ alert_body('phpfpm-down', 'PHP-FPM Down', 'php_fpm_up', 60, 1, 'lt', '2m', 'Alerting', 'Error', 'critical') }}
        annotations:
          summary: PHP-FPM socket/process check failed

{% if web_server == "apache" %}
{{ alert_body('apache-down', 'Apache Down', 'apache_up', 60, 1, 'lt', '2m', 'Alerting', 'Error', 'critical') }}
        annotations:
          summary: Apache service is not running
{% endif %}

{% if web_server == "nginx" %}
{{ alert_body('nginx-down', 'Nginx Down', 'nginx_up', 60, 1, 'lt', '2m', 'Alerting', 'Error', 'critical') }}
        annotations:
          summary: Nginx service is not running
{% endif %}

{{ alert_body('site-down', 'Site Down', 'site_up', 120, 1, 'lt', '2m', 'Alerting', 'Error', 'critical') }}
        annotations:
          summary: Website is not responding (HTTP != 200)

{{ alert_body('site-slow', 'Site Response Time > 5s', 'site_response_time_seconds', 120, 5, 'gt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}Site response time {{ $values.A.Value }}s (threshold: 5s) on {{ $labels.instance }}{% endraw %}

{{ alert_body('modx-core', 'MODX Core Missing', 'modx_core_ok', 300, 1, 'lt', '5m', 'OK', 'Error', 'critical') }}
        annotations:
          summary: MODX core files (config.core.php / modx.class.php) missing

{{ alert_body('modx-cache', 'MODX Cache Not Writable', 'modx_cache_ok', 300, 1, 'lt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: MODX cache directory (core/cache/) is not writable

{{ alert_body('victoria-down', 'VictoriaMetrics Down', 'victoria_up', 60, 1, 'lt', '1m', 'Alerting', 'Alerting', 'critical') }}
        annotations:
          summary: VictoriaMetrics health check failed

{{ alert_body('redis-down', 'Redis Down', 'redis_up', 60, 1, 'lt', '2m', 'Alerting', 'Error', 'critical') }}
        annotations:
          summary: Redis service is not running (sessions will be lost)

{{ alert_body('cron-backup', 'Backup Cron Not Running', '(time() - max_over_time(cron_last_run_backup[1d])) / 60', 86400, 90, 'gt', '10m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}Backup cron hasn't started for 90 min on {{ $labels.instance }} — backups run hourly, check systemd/scheduler{% endraw %}

{{ alert_body('upload-failed', 'Cloud Upload Failed', '(time() - upload_last_success_timestamp) / 3600', 86400, 2, 'gt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}No successful cloud upload in >2h (last: {{ $labels.instance }}) — check rclone/GDrive{% endraw %}

{{ alert_body('check-site-cron', 'Site Health Check Not Running', '(time() - max_over_time(check_site_last_run[10m]))', 600, 180, 'gt', '1m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: Site health check hasn't run for >3 min

{{ alert_body('ssl-expiry', 'SSL Cert Expiring Soon', 'ssl_days_remaining', 86400, 7, 'lt', '1h', 'OK', 'Alerting', 'info') }}
        annotations:
          summary: >-
            {% raw %}SSL cert expires in {{ $values.A.Value }} days on {{ $labels.instance }}{% endraw %}

{{ alert_body('admin-login', 'Admin Login Failed', 'admin_login_ok', 900, 1, 'lt', '15m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: Admin panel (/manager/) not responding with MODX content

{{ alert_body('cart-add', 'MiniShop2 Write Failed', 'db_write_ok', 900, 1, 'lt', '6m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            miniShop2 write probe failed — DB INSERT/delete check

{{ alert_body('db-tables-low', 'Database Tables Below Threshold', 'database_tables', 900, 50, 'lt', '6m', 'OK', 'Error', 'info') }}
        annotations:
          summary: >-
            {% raw %}Database {{ $labels.database }} has {{ $values.A.Value }} tables (expected ≥50){% endraw %}

{{ alert_body('backup-verify', 'Backup Verification Failed', 'backup_verification_ok', 86400, 1, 'lt', '5m', 'OK', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}Backup verification failed on {{ $labels.instance }} ({{ $labels.type }}){% endraw %}

{{ alert_body('check-services-cron', 'Service Check Not Running', '(time() - max_over_time(check_services_last_run[10m]))', 600, 600, 'gt', '10m', 'Alerting', 'Error', 'warning') }}
        annotations:
          summary: >-
            {% raw %}Service health check hasn't run for >10 min on {{ $labels.instance }} — check check-services.timer{% endraw %}

{% if grafana_cloud_url is defined and grafana_cloud_url | length > 0 %}
{{ alert_body('vmagent-remote-write', 'VMAgent Remote Write Failing', 'vmagent_remote_write_ok', 300, 1, 'lt', '10m', 'OK', 'Error', 'critical') }}
        annotations:
          summary: VMAgent is not pushing metrics to Grafana Cloud (process down or remote write failing for >10 min)
{% endif %}
