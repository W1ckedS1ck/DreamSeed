# Managed by Ansible

{% macro alert_body(uid, title, expr, range_from, thresh_val, thresh_type, for_dur, no_data, exec_err) %}
      - uid: dreamseed-{{ uid }}
        title: {{ title }}
        condition: B
        labels:
          env: {{ domain }}
        data:
          - refId: A
            datasourceUid: VictoriaMetrics
            queryType: ''
            relativeTimeRange:
              from: {{ range_from }}
              to: 0
            model:
              expr: '{{ expr }}'
              instant: true
              refId: A
          - refId: B
            datasourceUid: '__expr__'
            queryType: ''
            relativeTimeRange:
              from: {{ range_from }}
              to: 0
            model:
              type: threshold
              refId: B
              expression: A
              conditions:
                - evaluator:
                    params: [{{ thresh_val }}]
                    type: {{ thresh_type }}
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                  type: query
        noDataState: {{ no_data }}
        execErrState: {{ exec_err }}
        for: {{ for_dur }}
{% endmacro %}

apiVersion: 1

contactPoints:
  - orgId: 1
    name: Telegram
    receivers:
      - uid: dreamseed-telegram
        type: telegram
        settings:
          bottoken: "{{ grafana_telegram_token }}"
          chatid: "{{ grafana_telegram_chat_id }}"
          message: "{% raw %}{{ if .Alerts.Firing }}🔴 *{{ (index .Alerts.Firing 0).Labels.alertname }}* 🔴\n{{ .GroupLabels.env }}{{ range .Alerts.Firing }}{{ if .Annotations.summary }}\n{{ .Annotations.summary }}{{ end }}{{ end }}{{ end }}{{ if .Alerts.Resolved }}✅ *{{ (index .Alerts.Resolved 0).Labels.alertname }}* — resolved ✅\n{{ .GroupLabels.env }}{{ end }}{% endraw %}"
        disableResolveMessage: false

policies:
  - orgId: 1
    receiver: Telegram
    group_by:
      - alertname
      - env
    group_wait: 30s
    group_interval: 1m
    repeat_interval: 4h

groups:
  - orgId: 1
    name: DreamSeed
    folder: Alerts
    interval: 1m
    rules:

{{ alert_body('high-cpu', 'High CPU', '100 - (avg by(instance)(rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)', 300, 85, 'gt', '5m', 'OK', 'Error') }}
        annotations:
          summary: >-
            CPU usage > 85% for 5 min

{{ alert_body('high-ram', 'High RAM', '100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)', 300, 90, 'gt', '5m', 'OK', 'Error') }}
        annotations:
          summary: >-
            RAM usage > 90%

{{ alert_body('low-disk', 'Low Disk Space', '100 * node_filesystem_avail_bytes{fstype!~"tmpfs|devtmpfs",mountpoint="/"} / node_filesystem_size_bytes{fstype!~"tmpfs|devtmpfs",mountpoint="/"}', 300, 10, 'lt', '5m', 'OK', 'Error') }}
        annotations:
          summary: >-
            {% raw %}Disk < 10% free (mountpoint: {{ $labels.mountpoint }}){% endraw %}

{{ alert_body('mysql-down', 'MySQL Down', 'mysql_up', 60, 1, 'lt', '1m', 'Alerting', 'Error') }}
        annotations:
          summary: ""

{{ alert_body('phpfpm-down', 'PHP-FPM Down', 'php_fpm_up', 60, 1, 'lt', '1m', 'Alerting', 'Error') }}
        annotations:
          summary: ""

{% if web_server == "apache" %}
{{ alert_body('apache-down', 'Apache Down', 'apache_up', 60, 1, 'lt', '1m', 'Alerting', 'Error') }}
        annotations:
          summary: ""
{% endif %}

{% if web_server == "nginx" %}
{{ alert_body('nginx-down', 'Nginx Down', 'nginx_up', 60, 1, 'lt', '1m', 'Alerting', 'Error') }}
        annotations:
          summary: ""
{% endif %}

{{ alert_body('site-down', 'Site Down', 'site_up', 120, 1, 'lt', '2m', 'Alerting', 'Error') }}
        annotations:
          summary: Website is not responding (HTTP != 200)

{{ alert_body('modx-core', 'MODX Core Missing', 'modx_core_ok', 300, 1, 'lt', '2m', 'Alerting', 'Error') }}
        annotations:
          summary: ""

{{ alert_body('victoria-down', 'VictoriaMetrics Down', 'victoria_up', 60, 1, 'lt', '1m', 'OK', 'Alerting') }}
        annotations:
          summary: ""

{{ alert_body('cron-backup', 'Backup Cron Not Running', '(time() - max_over_time(cron_last_run_backup[1d])) / 60', 86400, 70, 'gt', '5m', 'Alerting', 'Error') }}
        annotations:
          summary: >-
            {% raw %}Backup cron hasn't run for 1h on {{ $labels.instance }} — check systemd/scheduler{% endraw %}

{{ alert_body('check-site-cron', 'Site Health Check Not Running', '(time() - max_over_time(check_site_last_run[10m]))', 600, 180, 'gt', '2m', 'Alerting', 'Error') }}
        annotations:
          summary: >-
            Site health check hasn't run for >3 min

{{ alert_body('ssl-expiry', 'SSL Cert Expiring Soon', 'ssl_days_remaining', 86400, 7, 'lt', '1h', 'Alerting', 'Alerting') }}
        annotations:
          summary: >-
            {% raw %}SSL cert expires in {{ $values.A }} days on {{ $labels.instance }}{% endraw %}

{{ alert_body('admin-login', 'Admin Login Failed', 'admin_login_ok', 180, 1, 'lt', '2m', 'Alerting', 'Error') }}
        annotations:
          summary: ""

{{ alert_body('cart-add', 'MiniShop2 Write Failed', 'db_write_ok', 180, 1, 'lt', '2m', 'Alerting', 'Error') }}
        annotations:
          summary: >-
            miniShop2 write probe failed — DB INSERT/delete check. See check_site.sh hourly metrics (ms2_endpoint_ok, ms2_tables_ok, admin_login_ok)
