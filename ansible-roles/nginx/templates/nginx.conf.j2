user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    # Cloudflare real IP (restores visitor IP behind CF proxy)
    # Included via conf.d/*.conf wildcard below.

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/access.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;

    map $http_accept $webp_ext {
        default "";
        "~*image/webp" ".webp";
    }

    brotli on;
    brotli_comp_level 4;
    brotli_static on;
    brotli_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;

    limit_req_zone $binary_remote_addr$request_method zone=modx_login:10m rate=120r/m;
    limit_req_zone $binary_remote_addr$request_method zone=modx_admin:10m rate=300r/m;

    # CSP violation reports (see /csp-report in vhost-ssl.conf.j2). $request_body is only
    # populated when the request is proxied, hence the loopback sink below.
    limit_req_zone $binary_remote_addr zone=csp_report:1m rate=120r/m;
    log_format csp_report '$time_iso8601 $remote_addr "$http_user_agent" $request_body';
    server {
        listen 127.0.0.1:8099;
        access_log off;
        location / {
            return 204;
        }
    }

    # WebSocket support for Grafana Live
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
