server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }} {{ www_domain }};

    location /.well-known/acme-challenge/ {
        root {{ web_root }};
    }

    location = /nginx_status {
        stub_status on;
        access_log off;
        allow 127.0.0.1;
        deny all;
    }

    location / {
        # Canonical host: never keep "www" in the URL. Redirecting to the apex
        # directly (instead of $host) turns a www request into one hop, while
        # $request_uri preserves the path and query string.
        return 301 https://{{ domain }}$request_uri;
    }
}
