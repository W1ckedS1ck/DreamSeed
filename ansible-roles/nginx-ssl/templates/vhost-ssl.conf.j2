{%- set csp_head = "default-src 'self'; script-src 'self' https://unpkg.com " -%}
{%- set csp_tail = "https://connect.facebook.net https://*.clarity.ms https://*.googletagmanager.com https://*.google-analytics.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com https://cdn.paddle.com https://*.paddle.com https://buy.paddle.com https://public.profitwell.com https://*.profitwell.com https://js.stripe.com https://*.stripe.com https://www.googleadservices.com https://www.google.com https://www.google.ru https://*.g.doubleclick.net https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://*.paddle.com https://buy.paddle.com; img-src 'self' data: https://www.gravatar.com https://lh3.googleusercontent.com https://www.facebook.com https://*.clarity.ms https://c.bing.com https://server.arcgisonline.com https://*.paddle.com https://*.paddle.io https://buy.paddle.com https://*.profitwell.com https://*.stripe.com https://*.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://*.google.com https://www.google.ru https://www.googleadservices.com https://pagead2.googlesyndication.com https://ad.doubleclick.net https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://google.by https://*.google.by https://www.google.ge https://yandex.ru https://*.yandex.ru; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://www.google.ge https://*.clarity.ms https://connect.facebook.net https://www.facebook.com https://cloudflareinsights.com https://*.paddle.com https://*.paddle.io https://buy.paddle.com https://checkout-service.paddle.com https://checkout-analytics.paddle.com https://*.profitwell.com https://*.stripe.com https://api.stripe.com https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://*.google.com https://www.google.ru https://www.googleadservices.com https://pagead2.googlesyndication.com https://ad.doubleclick.net https://mc.yandex.ru https://mc.yandex.com https://*.mc.yandex.ru https://*.mc.yandex.com https://yastatic.net https://mpc-prod-27-s6uit34pua-uk.a.run.app https://mm-b87d1f4411634570a31077b00488b380.ecs.us-east-1.on.aws; frame-src https://*.paddle.com https://*.paddle.io https://buy.paddle.com https://js.stripe.com https://*.stripe.com https://m.stripe.network https://*.googletagmanager.com https://td.doubleclick.net https://bid.g.doubleclick.net https://www.google.com https://www.google.ru https://mc.yandex.ru https://mc.yandex.com https://www.facebook.com https://*.facebook.com; frame-ancestors 'self';" -%}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain }};
{% if faro_enabled | bool and faro_collector_url | length > 0 %}
    # Faro RUM: inject only a tiny first-party loader. The SDK itself is loaded
    # after page load, only for sampled sessions, and never with web-tracing.
    # Resolve the collector hostname at request time (systemd-resolved), so a
    # Grafana IP change does not leave nginx proxying to a stale address.
    resolver 127.0.0.53 valid=300s ipv6=off;
    gunzip on;
    sub_filter_once on;
    sub_filter '</head>' '<script src="{{ faro_loader_path }}?v={{ faro_loader_version }}" defer></script></head>';
{% endif %}

    # DreamSeed: strip ?lang= to avoid CF hollow-language cache variants
    # Cookie is set by DreamSeedLang / dreamseed-i18n.js; keep URL language-neutral.
    if ($arg_lang != "") {
        set $ds_lang_strip 1;
    }
    if ($ds_lang_strip = 1) {
        return 302 $uri;
    }

    # Block direct IP access (bypasses Cloudflare WAF)
    # localhost and IP loopbacks allowed for local monitoring and health checks
    if ($host !~* ^({{ domain }}|localhost|127\.0\.0\.1|\[?::1\]?)$) {
        return 444;
    }

    root {{ web_root }};
    index index.php index.html index.htm;

{% if ssl_has_cert | default(false) %}
    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% else %}
    ssl_certificate /etc/ssl/certs/selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/selfsigned.key;
{% endif %}

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
{% if deploy_env not in ['prod', 'prod-hetz'] %}
    add_header X-Robots-Tag "noindex, nofollow" always;
{% endif %}

    # CSP: site + Paddle/ProfitWell + GA4/gtag + Google Ads + Yandex.Metrika.
    # GA diagnostics flagged missing analytics.google.com / ad.doubleclick.net — use Google wildcards.
    # Paddle checkout embeds buy.paddle.com + Stripe (js.stripe.com / m.stripe.network).
    # Missing Stripe frame-src can surface as Paddle overlay E-403 for card entry.
    add_header Content-Security-Policy "{{ csp_head }}'unsafe-inline' {{ csp_tail }}" always;

    # HTML cache: per-request TTL from dreamseed-cache-map.conf (logged-in and account/cart paths: no-store).
    add_header Cache-Control $dreamseed_cache_control always;
    add_header Cloudflare-CDN-Cache-Control $dreamseed_cf_cache_control always;

    client_max_body_size 64M;

    access_log /var/log/nginx/{{ domain }}-ssl-access.log;
    error_log /var/log/nginx/{{ domain }}-ssl-error.log;

    # --- Telegram Bot Health (Better Stack monitor probes /bot-health) ---
    location = /bot-health {
        proxy_pass http://127.0.0.1:8553/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # must stay fresh for the uptime monitor — never cached
        add_header Cache-Control "no-store" always;
        access_log off;
    }

    # Auth/account HTML is personalized (gift codes, KBZh unlock notice) — never edge-cache.
    location ^~ /personal-account {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ @modx;
    }

    # Old RU translit map URL → English slug
    location = /karta-mechtatelej {
        return 301 /garden-of-dreamers;
    }
    location = /karta-mechtatelej/ {
        return 301 /garden-of-dreamers;
    }

    # Duplicate cart URL: one canonical address for search engines
    location = /cart/ {
        return 301 /cart;
    }

    # CSP violation reports, POST only. Proxied to the loopback sink so the body gets logged;
    # written to its own file, which promtail already ships (glob *access*).
    location = /csp-report {
        limit_except POST { deny all; }
        limit_req zone=csp_report burst=120 nodelay;
        # Browsers report CSP violations automatically. Keep the error log quiet
        # and answer 429 (not 503) when a noisy page exceeds the sampled rate.
        limit_req_status 429;
        limit_req_log_level notice;
        client_max_body_size 8k;
        access_log /var/log/nginx/{{ domain }}-csp-access.log csp_report;
        add_header Cache-Control "no-store" always;
        proxy_pass http://127.0.0.1:8099;
    }

    location / {
        try_files $uri $uri/ @modx;
    }

    location @modx {
        rewrite ^/(.*)$ /index.php?q=$1&$args last;
    }

    location ^~ /manager {
        limit_req zone=modx_admin burst=200 nodelay;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.gravatar.com; font-src 'self' data:; frame-ancestors 'self';" always;
        try_files $uri $uri/ @modx;

        {% include 'php_fastcgi.conf.j2' %}
    }

    location ^~ /connectors {
        limit_req zone=modx_login burst=120 nodelay;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri $uri/ @modx;

        {% include 'php_fastcgi.conf.j2' %}
    }

    location ~* adminer {
        deny all;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ~* \.sql\.zip|\.sql\.gz|^/backup\. {
        deny all;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    {% include 'php_fastcgi.conf.j2' %}

    location ~* \.(jpg|jpeg|png)$ {
        try_files $uri$webp_ext $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ~* \.(ico|css|js|svg|woff|woff2|ttf|eot|otf|webp|mp4|webm|m4v|ogg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ^~ /core {
        deny all;
        return 404;
    }

    location ~ /\.ht {
        deny all;
    }

    location = /favicon.ico {
        try_files $uri =404;
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    # Grafana Live WebSocket support
    location ^~ /grafana/api/live/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:{{ grafana_port }};
    }

    location ^~ /grafana {
        # Defense-in-depth basic auth in front of Grafana's own login.
        # Enabled only when grafana_htpasswd is provisioned (deploy-time var).
        # If unset, falls through to Grafana's own login form (still requires
        # valid admin creds from GRAFANA_PASS — but no extra brute-force gate).
{% if grafana_htpasswd | default('') | length > 0 %}
        auth_basic "Grafana";
        auth_basic_user_file /etc/nginx/.grafana_htpasswd;
{% endif %}
        proxy_pass http://127.0.0.1:{{ grafana_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grafana has its own CSP; omit the site-wide one so the news panel
        # can fetch from grafana.com and plugins can load their own assets.
        # (Nginx does not inherit parent add_header when a child block has any,
        #  so the server-level CSP is already absent here — this is explicit.)
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        add_header Cloudflare-CDN-Cache-Control "no-cache";
    }

{% if faro_enabled | bool and faro_collector_url | length > 0 %}
    # Sampled Faro RUM ingress. POST-only, short timeouts: a slow collector can
    # never hold a browser connection open for long.
    location = {{ faro_collect_path }} {
        limit_except POST { deny all; }
        client_max_body_size 1m;
        set $faro_host {{ faro_collector_url | regex_replace('^https?://', '') | regex_replace('/.*$', '') }};
        proxy_pass https://$faro_host{{ faro_collector_url | regex_replace('^https?://[^/]+', '') }};
        proxy_set_header Host $faro_host;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 2s;
        proxy_send_timeout 3s;
        proxy_read_timeout 3s;
        proxy_buffering off;
    }
{% endif %}

    # Old cached Faro clients still hold the pre-disable SDK. Never proxy them
    # upstream: answer fast so they cannot stall a tab, even when RUM is enabled.
    location /faro-collect {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 204;
    }
}

# --- Canonical host: www.{{ domain }} -> {{ domain }} (301) ---
# Separate server block on purpose: the apex block above ends unknown Host
# headers with 444 (direct-IP / WAF-bypass guard), and nginx picks a vhost by
# SNI + Host, so "www" needs its own block. The certificate in this lineage
# covers both names (ssl role, DNS-01 challenge).
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ www_domain }};

    access_log /var/log/nginx/{{ domain }}-ssl-access.log;
    error_log /var/log/nginx/{{ domain }}-ssl-error.log;

{% if ssl_has_cert | default(false) %}
    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
{% else %}
    ssl_certificate /etc/ssl/certs/selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/selfsigned.key;
{% endif %}

    # Redirect-only vhost: inherit nginx's default TLS policy (TLSv1.2/1.3) and
    # keep HSTS so the browser pins the host even before it lands on the apex.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # $request_uri keeps path + query, so deep links survive the redirect.
    return 301 https://{{ domain }}$request_uri;
}
