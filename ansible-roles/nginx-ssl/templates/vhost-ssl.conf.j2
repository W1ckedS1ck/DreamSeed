server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain }}
    {%- if domain_www | default(false) %} www.{{ domain }}{% endif %};
{% if faro_enabled and faro_collector_url | length > 0 %}
    sub_filter_types text/html;
    sub_filter_once on;
    sub_filter '</head>' '<script>(function(){var s=document.createElement("script");s.src="https://unpkg.com/@grafana/faro-web-sdk@2/dist/bundle/faro-web-sdk.iife.js";s.onload=function(){window.GrafanaFaroWebSdk.initializeFaro({url:"/faro-collect",app:{name:"{{ faro_app_name }}",version:"1.0.0",environment:"production"},sessionTracking:{samplingRate:1,persistent:true}});var t=document.createElement("script");t.src="https://unpkg.com/@grafana/faro-web-tracing@2/dist/bundle/faro-web-tracing.iife.js";t.onload=function(){window.GrafanaFaroWebSdk.faro.instrumentations.add(new window.GrafanaFaroWebTracing.TracingInstrumentation())};document.head.appendChild(t)};document.head.appendChild(s)})();</script></head>';
{% endif %}

    # Block direct IP access (bypasses Cloudflare WAF)
    # localhost is allowed for local monitoring
    if ($host !~* ^({{ domain }}{% if domain_www | default(false) %}{{ "|www\\." }}{{ domain }}{% endif %}|localhost)$) {
        return 444;
    }

    root {{ web_root }};
    index index.php index.html index.htm;

{% if ssl_has_cert | default(false) %}
    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% else %}
    ssl_certificate /etc/ssl/certs/selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/selfsigned.key;
{% endif %}

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;

    add_header Content-Security-Policy "default-src 'self';
script-src 'self' https://unpkg.com 'unsafe-inline' https://connect.facebook.net https://*.clarity.ms https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;
style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com;
img-src 'self' data: https://www.gravatar.com https://www.facebook.com https://*.clarity.ms https://c.bing.com;
font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com;
connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://*.clarity.ms https://connect.facebook.net https://www.facebook.com;
frame-ancestors 'self';" always;

    client_max_body_size 64M;

    access_log /var/log/nginx/{{ domain }}-ssl-access.log;
    error_log /var/log/nginx/{{ domain }}-ssl-error.log;

    location / {
        try_files $uri $uri/ @modx;
    }

    location @modx {
        rewrite ^/(.*)$ /index.php?q=$1 last;
    }

    location ^~ /manager {
        limit_req zone=modx_admin burst=5 nodelay;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self';
script-src 'self' 'unsafe-inline' 'unsafe-eval';
style-src 'self' 'unsafe-inline';
img-src 'self' data: https://www.gravatar.com;
font-src 'self' data:;
frame-ancestors 'self';" always;
        try_files $uri $uri/ @modx;

        {% include 'php_fastcgi.conf.j2' %}
    }

    location ^~ /connectors {
        limit_req zone=modx_login burst=50 nodelay;
        try_files $uri $uri/ @modx;

        {% include 'php_fastcgi.conf.j2' %}
    }

    location ~* adminer {
        deny all;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ~* \.sql\.zip|\.sql\.gz|backup {
        deny all;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    {% include 'php_fastcgi.conf.j2' %}

    location ~* \.(jpg|jpeg|gif|png|ico|css|js|svg|woff|woff2|ttf|eot|otf|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ^~ /core {
        deny all;
        return 404;
    }

    location ~ /\.ht {
        deny all;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    location ^~ /grafana {
        proxy_pass http://127.0.0.1:{{ grafana_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grafana has its own CSP; omit the site-wide one so the news panel
        # can fetch from grafana.com and plugins can load their own assets.
        # (Nginx does not inherit parent add_header when a child block has any,
        #  so the server-level CSP is already absent here — this is explicit.)
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        add_header Cloudflare-CDN-Cache-Control "no-cache";
    }

    location = /bot-health {
        proxy_pass http://127.0.0.1:8553/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        access_log off;
    }
{% if faro_enabled and faro_collector_url | length > 0 %}
    location /faro-collect {
        proxy_pass {{ faro_collector_url }};
        proxy_set_header Host {{ faro_collector_url | regex_replace('^https?://', '') | regex_replace('/.*$', '') }};
        proxy_ssl_server_name on;
    }
{% endif %}
}
