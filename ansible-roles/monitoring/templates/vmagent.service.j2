# Managed by Ansible
[Unit]
Description=vmagent - VictoriaMetrics Agent (Grafana Cloud)
After=network.target

[Service]
User=vmagent
Group=vmagent
WorkingDirectory=/var/lib/vmagent
EnvironmentFile=/etc/vmagent/credentials.env
ExecStart=/usr/local/bin/vmagent \
  -remoteWrite.url=${VM_CLOUD_URL} \
  -remoteWrite.basicAuth.username=${VM_CLOUD_USER} \
  -remoteWrite.basicAuth.passwordFile=/etc/vmagent/password.txt \
  -remoteWrite.label=env={{ deploy_env }} \
  -promscrape.config=/etc/vmagent/scrape.yml \
  -remoteWrite.queues=4 \
  -httpListenAddr=127.0.0.1:8429
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
