# Managed by Ansible — vmagent scrape config
global:
  scrape_interval: 30s

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["localhost:9100"]
        labels:
          instance: "{{ domain }}"

{% if web_server == "apache" %}
  - job_name: apache
    static_configs:
      - targets: ["localhost:9117"]
        labels:
          instance: "{{ domain }}"
{% elif web_server == "nginx" %}
  - job_name: nginx
    static_configs:
      - targets: ["localhost:9113"]
        labels:
          instance: "{{ domain }}"
{% endif %}

{% if db_pass | default('') | length > 0 %}
  - job_name: mysql
    static_configs:
      - targets: ["localhost:9104"]
        labels:
          instance: "{{ domain }}"
{% endif %}

  - job_name: victoria-metrics
    static_configs:
      - targets: ["localhost:8428"]
        labels:
          instance: "{{ domain }}"
