# Fail2ban filter for MODX admin panel brute-force attempts.
# MODX returns HTTP 200 even on failed login; tracks POST to the login connector.
#
# No ignoreregex: Referer/UA are attacker-controlled, so they can't gate this
# jail. Real per-account brute-force defense is MODX's own login lockout
# (failed_login_attempts/blocked_minutes). This jail is just a per-IP
# volumetric cap — maxretry set above legitimate AJAX burst levels.

[Definition]
failregex = ^<HOST> .* "POST /connectors/index.php.*"$
# NOTE: fail2ban strips the timestamp before matching — [time] arrives as [].
ignoreregex =
