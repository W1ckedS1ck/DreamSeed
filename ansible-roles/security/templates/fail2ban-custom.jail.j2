# Web jails ban at the Cloudflare EDGE (via cloudflare-token action) — the firewall
# only sees CF edge IPs, so nftables bans can never match web traffic. Detection is
# log-based (real visitor IPs via CF-Connecting-IP); enforcement is the CF API.
# Falls back to log-only (banaction=none) when CLOUDFLARE_FIREWALL_TOKEN is unset.
# notes has NO spaces — the actionunban search URL must stay valid.

# ==== SSH ====

[sshd]
enabled  = true
port     = ssh
backend  = pyinotify
logpath  = /var/log/auth.log
maxretry = 5
bantime  = 1h
filter = sshd[publickey=any]

# ==== MODX Admin Panel brute-force ====

[modx-admin]
enabled     = true
port        = http,https
{% if cloudflare_firewall_token | default('', true) | length > 0 %}
action      = cloudflare-token[cfzone="{{ cloudflare_zone_id | default('') }}", cftoken="{{ cloudflare_firewall_token }}", notes="DreamSeed-modx-admin"]
{% else %}
banaction   = none
{% endif %}
filter      = modx-admin
backend     = pyinotify
{% if web_server == "nginx" %}
logpath  = /var/log/nginx/{{ domain }}-ssl-access.log
{% else %}
logpath  = /var/log/apache2/{{ domain }}-ssl-access.log
{% endif %}
maxretry = 25
findtime = 600
bantime  = 3600

{% if web_server == "nginx" %}
# ==== Vulnerability scanner detection (nginx access log format) ====

[dreamseed-botsearch]
enabled     = true
port        = http,https
{% if cloudflare_firewall_token | default('', true) | length > 0 %}
action      = cloudflare-token[cfzone="{{ cloudflare_zone_id | default('') }}", cftoken="{{ cloudflare_firewall_token }}", notes="DreamSeed-botsearch"]
{% else %}
banaction   = none
{% endif %}
filter      = dreamseed-botsearch
backend     = pyinotify
logpath     = /var/log/nginx/{{ domain }}-ssl-access.log
maxretry    = 2
findtime    = 600
bantime     = 12h

[dreamseed-bad-request]
enabled     = true
port        = http,https
{% if cloudflare_firewall_token | default('', true) | length > 0 %}
action      = cloudflare-token[cfzone="{{ cloudflare_zone_id | default('') }}", cftoken="{{ cloudflare_firewall_token }}", notes="DreamSeed-bad-request"]
{% else %}
banaction   = none
{% endif %}
filter      = dreamseed-bad-request
backend     = pyinotify
logpath     = /var/log/nginx/{{ domain }}-ssl-access.log
maxretry    = 6
findtime    = 600
bantime     = 1h

[nginx-http-auth]
enabled  = false
port     = http,https
logpath  = /var/log/nginx/error.log

{% else %}
[apache-auth]
enabled  = false
port     = http,https
logpath  = /var/log/apache2/{{ domain }}-error.log
maxretry = 5
bantime  = 1h

[apache-shellshock]
enabled  = false
port     = http,https
logpath  = /var/log/apache2/{{ domain }}-error.log
maxretry = 1
bantime  = 1d

[apache-badbots]
enabled  = false
port     = http,https
logpath  = /var/log/apache2/{{ domain }}-access.log
maxretry = 2
bantime  = 12h

[apache-noscript]
enabled  = false
port     = http,https
logpath  = /var/log/apache2/{{ domain }}-error.log
maxretry = 6
bantime  = 1h
{% endif %}

# ==== Recidive (edge-ban too) ====

[recidive]
enabled  = true
{% if cloudflare_firewall_token | default('', true) | length > 0 %}
action   = cloudflare-token[cfzone="{{ cloudflare_zone_id | default('') }}", cftoken="{{ cloudflare_firewall_token }}", notes="DreamSeed-recidive"]
{% else %}
banaction = none
{% endif %}
logpath  = /var/log/fail2ban.log
maxretry = 3
findtime = 86400
bantime  = 604800
