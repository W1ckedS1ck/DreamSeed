# Custom Fail2ban jails for DreamSeed
# Web jails disabled — behind Cloudflare, iptables bans are useless.
# Protect web layer via Cloudflare WAF/Rate Limiting instead.

# ============================================================
# SSH (works behind iptables, not behind Cloudflare)
# ============================================================
[sshd]
enabled  = true
port     = ssh
backend  = pyinotify
logpath  = /var/log/auth.log
maxretry = 5
bantime  = 1h
filter = sshd[publickey=any]

# ============================================================
# MODX Admin Panel — disabled (behind Cloudflare)
# ============================================================
[modx-admin]
enabled     = false
port        = http,https
filter      = modx-admin
backend     = pyinotify
{% if web_server == "nginx" %}
logpath  = /var/log/nginx/{{ domain }}-ssl-access.log
{% else %}
logpath  = /var/log/apache2/{{ domain }}-ssl-access.log
{% endif %}
maxretry = 100
findtime = 600
bantime  = 3600

# ============================================================
# Web server jails — disabled (behind Cloudflare)
# ============================================================
{% if web_server == "nginx" %}
[nginx-http-auth]
enabled  = false
port     = http,https
logpath  = /var/log/nginx/error.log
maxretry = 5
bantime  = 1h

[nginx-botsearch]
enabled  = false
port     = http,https
maxretry = 2
bantime  = 12h

[nginx-bad-request]
enabled  = false
port     = http,https
maxretry = 6
bantime  = 1h

{% else %}
[apache-auth]
enabled  = false
port     = http,https
maxretry = 5
bantime  = 1h

[apache-shellshock]
enabled  = false
port     = http,https
maxretry = 1
bantime  = 1d

[apache-badbots]
enabled  = false
port     = http,https
maxretry = 2
bantime  = 12h

[apache-noscript]
enabled  = false
port     = http,https
maxretry = 6
bantime  = 1h
{% endif %}

# ============================================================
# Recidive — extends bans for repeat offenders (SSH only)
# ============================================================
[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
maxretry = 3
findtime = 86400
bantime  = 604800
