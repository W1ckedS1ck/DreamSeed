# Custom Fail2ban jails for DreamSeed

# ============================================================
# SSH
# ============================================================
[sshd]
enabled  = true
port     = ssh
maxretry = 5
bantime  = 1h

# ============================================================
# MODX Admin Panel
# ============================================================
[modx-admin]
enabled     = true
port        = http,https
filter      = modx-admin
backend     = pyinotify
{% if web_server == "nginx" %}
logpath  = /var/log/nginx/{{ domain }}-ssl-access.log
{% else %}
logpath  = /var/log/apache2/{{ domain }}-ssl-access.log
{% endif %}
maxretry = 100
findtime = 600
bantime  = 3600

# ============================================================
# Web server jails
# ============================================================
{% if web_server == "nginx" %}
[nginx-http-auth]
enabled  = true
port     = http,https
maxretry = 5
bantime  = 1h

[nginx-botsearch]
enabled  = true
port     = http,https
maxretry = 2
bantime  = 12h

[nginx-bad-request]
enabled  = true
port     = http,https
maxretry = 6
bantime  = 1h

{% else %}
[apache-auth]
enabled  = true
port     = http,https
maxretry = 5
bantime  = 1h

[apache-shellshock]
enabled  = true
port     = http,https
maxretry = 1
bantime  = 1d

[apache-badbots]
enabled  = true
port     = http,https
maxretry = 2
bantime  = 12h

[apache-noscript]
enabled  = true
port     = http,https
maxretry = 6
bantime  = 1h
{% endif %}

# ============================================================
# Recidive — persistent offenders get 1 week ban
# ============================================================
[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
maxretry = 3
findtime = 86400
bantime  = 604800
