# DreamSeed SSH Hardening
# 00 prefix = processed first (sshd first-wins rule) — overrides 50-cloud-init.conf
PasswordAuthentication no
PermitRootLogin no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
MaxAuthTries 3
MaxSessions 10
ClientAliveCountMax 2
LogLevel VERBOSE
AllowUsers ubuntu
AuthorizedKeysFile .ssh/authorized_keys
ClientAliveInterval 300
UseDNS no
Compression no
TCPKeepAlive no
Banner /etc/issue.net
