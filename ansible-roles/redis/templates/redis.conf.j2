# Managed by Ansible — DreamSeed Redis
bind 127.0.0.1
port 6379
daemonize no
supervised systemd
loglevel notice

# Session data: 256 MB ceiling, LRU eviction
maxmemory 256mb
maxmemory-policy allkeys-lru

# Persistence: OFF for now — debug RDB issues before enabling
# save 900 1
# dir /var/lib/redis
# dbfilename dump.rdb
# appendonly no

# Resilience: keep accepting writes even if persistence fails
stop-writes-on-bgsave-error no

# Basic hardening
rename-command FLUSHALL ""
rename-command FLUSHDB ""
rename-command CONFIG ""
rename-command SHUTDOWN ""
rename-command DEBUG ""
rename-command SCRIPT ""
