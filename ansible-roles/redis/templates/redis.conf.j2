# Managed by Ansible — DreamSeed Redis
bind 127.0.0.1
port 6379
daemonize no
supervised systemd
loglevel notice

# Session data: 256 MB ceiling, LRU eviction
maxmemory 256mb
maxmemory-policy allkeys-lru

# RDB Persistence — recover sessions after crash/restart
save 900 1              # Snapshot every 15 min if ≥1 key changed (typical: every 15 min on prod)
dir /var/lib/redis      # RDB file location
dbfilename dump.rdb     # RDB file name

# NO AOF — avoid disk I/O overhead for ephemeral session data
appendonly no

# Resilience: keep accepting writes even if RDB persistence fails
# If /var/lib/redis fills or permissions break, Redis won't block session writes
stop-writes-on-bgsave-error no

# Basic hardening
rename-command FLUSHALL ""
rename-command FLUSHDB ""
rename-command CONFIG ""
rename-command SHUTDOWN ""
rename-command DEBUG ""
rename-command SCRIPT ""
