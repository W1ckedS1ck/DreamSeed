# Managed by Ansible — DO NOT EDIT ON SERVER.
# Rendered from ansible-roles/backup/templates/server.env.j2
# Whitelist: only variables the server-side scripts actually need.
# Explicitly EXCLUDED: AWS/Hetzner/Cloudflare credentials — those live on the
# control plane only and must never leave it.

# --- Environment identifier (used for backup paths and alerts) ---
ENV="{{ deploy_env }}"

# --- Telegram (bot + reports + alerts) ---
TG_TOKEN="{{ lookup('env', 'TG_TOKEN') | mandatory('TG_TOKEN must be set in secrets/.env') }}"
TG_CHAT_ID="{{ lookup('env', 'TG_CHAT_ID') | mandatory('TG_CHAT_ID must be set in secrets/.env') }}"
TG_THREAD_ID="{{ lookup('env', 'TG_THREAD_ID') | default('') }}"
OWNER="{{ lookup('env', 'OWNER') | default('', true) }}"

# --- Telegram bot runtime ---
BOT_USERNAME="{{ lookup('env', 'BOT_USERNAME') | default('DreamSeedOnline_bot', true) }}"
# DB_PREFIX = filename prefix for DB backup files (telegram_bot.py strips this for cleaner output)
# Example: db_2026-07-25.sql.gz → "2026-07-25" in Telegram messages
# NOT the MODX table prefix (that's MODX_TABLE_PREFIX=modx_)
DB_PREFIX="{{ lookup('env', 'DB_PREFIX') | default('db_', true) }}"
MODX_TABLE_PREFIX="{{ db_prefix }}"

# --- Database name (scripts use ~/.my.cnf for password) ---
DB_NAME="{{ db_name }}"

# --- Paths ---
PROJECT_DIR="{{ web_root }}"
BACKUP_DIR="{{ backup_dir }}"
DOMAIN="{{ domain }}"

# --- Backup retention ---
PROJECT_KEEP={{ backup_project_keep | default(5) }}
DB_KEEP={{ backup_db_keep | default(15) }}
CLOUD_PROJECT_KEEP={{ cloud_project_keep | default(10) }}
CLOUD_DB_KEEP={{ cloud_db_keep | default(100) }}

# --- Better Uptime (external cron watchdog) ---# BETTERUPTIME_API_TOKEN intentionally omitted — used only by local dev scripts (setup_betteruptime.sh, list_betteruptime.sh).
# Server-side heartbeats use individual write-only keys below.
BETTERUPTIME_BACKUP_KEY="{{ lookup('env', 'BETTERUPTIME_BACKUP_KEY') | default('', true) }}"
BETTERUPTIME_GDRIVE_KEY="{{ lookup('env', 'BETTERUPTIME_GDRIVE_KEY') | default('', true) }}"
BETTERUPTIME_REPORT_DAILY_KEY="{{ lookup('env', 'BETTERUPTIME_REPORT_DAILY_KEY') | default('', true) }}"
BETTERUPTIME_REPORT_WEEKLY_KEY="{{ lookup('env', 'BETTERUPTIME_REPORT_WEEKLY_KEY') | default('', true) }}"
BETTERUPTIME_VERIFY_KEY="{{ lookup('env', 'BETTERUPTIME_VERIFY_KEY') | default('', true) }}"
BETTERUPTIME_CHECK_SERVICES_KEY="{{ lookup('env', 'BETTERUPTIME_CHECK_SERVICES_KEY') | default('', true) }}"
