# Managed by Ansible — DO NOT EDIT ON SERVER.
# Rendered from ansible-roles/backup/templates/server.env.j2
# Whitelist: only variables the server-side scripts actually need.
# Explicitly EXCLUDED: AWS/Hetzner/Cloudflare credentials — those live on the
# control plane only and must never leave it.

# --- Telegram (bot + reports + alerts) ---
TG_TOKEN="{{ lookup('env', 'TG_TOKEN') }}"
TG_CHAT_ID="{{ lookup('env', 'TG_CHAT_ID') }}"
TG_THREAD_ID="{{ lookup('env', 'TG_THREAD_ID') }}"
OWNER="{{ lookup('env', 'OWNER') }}"

# --- Telegram bot runtime ---
BOT_USERNAME="{{ lookup('env', 'BOT_USERNAME') | default('DreamSeedOnline_bot', true) }}"
DB_PREFIX="{{ lookup('env', 'DB_PREFIX') | default('db_modx_db_', true) }}"

# --- Database name (scripts use ~/.my.cnf for password) ---
DB_NAME="{{ db_name }}"

# --- Paths ---
PROJECT_DIR=/var/www/html
BACKUP_DIR=/home/ubuntu/backups
DOMAIN={{ domain }}

# --- Backup retention ---
PROJECT_KEEP=5
DB_KEEP=15
CLOUD_PROJECT_KEEP=10
CLOUD_DB_KEEP=20

# --- SMTP (manual test_mail.py only — optional) ---
EMAIL_USER="{{ lookup('env', 'EMAIL_USER') }}"
EMAIL_PASS="{{ lookup('env', 'EMAIL_PASS') }}"
SMTP_SERVER="{{ lookup('env', 'SMTP_SERVER') }}"
SMTP_PORT="{{ lookup('env', 'SMTP_PORT') }}"

