BETTERUPTIME_BACKUP_KEY="{{ lookup('env', 'BETTERUPTIME_BACKUP_KEY') }}"
BETTERUPTIME_GDRIVE_KEY="{{ lookup('env', 'BETTERUPTIME_GDRIVE_KEY') }}"
BETTERUPTIME_REPORT_DAILY_KEY="{{ lookup('env', 'BETTERUPTIME_REPORT_DAILY_KEY') }}"
BETTERUPTIME_REPORT_WEEKLY_KEY="{{ lookup('env', 'BETTERUPTIME_REPORT_WEEKLY_KEY') }}"
