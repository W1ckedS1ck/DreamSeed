# HEALTHCHECK_REPORT_WEEKLY_UUID="{{ lookup('env', 'HEALTHCHECK_REPORT_WEEKLY_UUID') }}"
# BETTERUPTIME_API_TOKEN intentionally omitted — used only by local dev scripts (setup_betteruptime.sh, list_betteruptime.sh).
