[PHP]
memory_limit = {{ php_memory_limit | default('512M') }}
post_max_size = {{ php_post_max_size | default('64M') }}
upload_max_filesize = {{ php_upload_max_filesize | default('32M') }}
max_execution_time = {{ php_max_execution_time | default(300) }}
max_input_time = {{ php_max_input_time | default(300) }}
disable_functions = {{ php_disable_functions | default('shell_exec,system,passthru,proc_open,popen,pcntl_exec,phpinfo') }}
expose_php = Off
allow_url_include = Off
cgi.fix_pathinfo = 0

[Session]
session.cookie_secure = On
session.cookie_httponly = On
session.cookie_samesite = Lax
session.use_strict_mode = On
