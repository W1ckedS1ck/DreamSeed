; Managed by Ansible
; validate_timestamps=1: this is a MUTABLE server — the developer edits
; PHP/templates via SFTP and AI agents over SSH, outside deploys. Edits become
; visible within revalidate_freq (5s) with no manual step. Deploys restart FPM
; anyway, which guarantees invalidation for shipped code.
zend_extension=opcache
opcache.enable=1
opcache.enable_cli=0
opcache.memory_consumption={{ opcache_memory_consumption | default(128) }}
opcache.interned_strings_buffer={{ opcache_interned_strings_buffer | default(16) }}
opcache.max_accelerated_files={{ opcache_max_accelerated_files | default(20000) }}
opcache.revalidate_freq=5
opcache.validate_timestamps=1
opcache.save_comments=1
